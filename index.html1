<!doctype html>
<html lang="th" class="h-full">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HeatSentry - ระบบเฝ้าระวังฮีทสโตรก</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/_sdk/element_sdk.js"></script>
  <script src="/_sdk/data_sdk.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800;900&amp;family=Orbitron:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
  <style>
    body {
      box-sizing: border-box;
    }
    
    * {
      font-family: 'Kanit', sans-serif;
    }
    
    .orbitron {
      font-family: 'Orbitron', monospace;
    }
    
    @keyframes pulse-ring {
      0% { transform: scale(0.9); opacity: 1; }
      50% { transform: scale(1.1); opacity: 0.5; }
      100% { transform: scale(0.9); opacity: 1; }
    }
    
    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      10% { transform: scale(1.15); }
      20% { transform: scale(1); }
      30% { transform: scale(1.1); }
      40% { transform: scale(1); }
    }
    
    @keyframes danger-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      50% { box-shadow: 0 0 0 20px rgba(239, 68, 68, 0); }
    }
    
    @keyframes countdown-pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    
    @keyframes siren-flash {
      0%, 100% { background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%); }
      50% { background: linear-gradient(135deg, #f87171 0%, #dc2626 100%); }
    }
    
    @keyframes slide-up {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    
    @keyframes glow {
      0%, 100% { filter: drop-shadow(0 0 8px currentColor); }
      50% { filter: drop-shadow(0 0 16px currentColor); }
    }
    
    .animate-heartbeat {
      animation: heartbeat 1.2s ease-in-out infinite;
    }
    
    .animate-pulse-ring {
      animation: pulse-ring 2s ease-in-out infinite;
    }
    
    .animate-danger-pulse {
      animation: danger-pulse 1.5s ease-in-out infinite;
    }
    
    .animate-countdown {
      animation: countdown-pulse 1s ease-in-out infinite;
    }
    
    .animate-siren {
      animation: siren-flash 0.5s ease-in-out infinite;
    }
    
    .animate-slide-up {
      animation: slide-up 0.3s ease-out forwards;
    }
    
    .animate-glow {
      animation: glow 2s ease-in-out infinite;
    }
    
    .glass-effect {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .gradient-bg {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    }
    
    .risk-green { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); }
    .risk-yellow { background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%); }
    .risk-red { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }
    
    .nav-item {
      transition: all 0.3s ease;
    }
    
    .nav-item.active {
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      transform: scale(1.1);
    }
    
    .card-shadow {
      box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.5);
    }
    
    input:focus, textarea:focus {
      outline: none;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
    }
    
    .sos-button {
      background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
      box-shadow: 0 10px 40px -10px rgba(220, 38, 38, 0.5);
    }
    
    .sos-button:active {
      transform: scale(0.95);
    }
    
    .map-container {
      background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%);
      position: relative;
      overflow: hidden;
    }
    
    .map-grid {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(59, 130, 246, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(59, 130, 246, 0.1) 1px, transparent 1px);
      background-size: 20px 20px;
    }
    
    .location-dot {
      width: 16px;
      height: 16px;
      background: #3b82f6;
      border-radius: 50%;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
    
    .location-dot::before {
      content: '';
      position: absolute;
      inset: -8px;
      border: 3px solid rgba(59, 130, 246, 0.5);
      border-radius: 50%;
      animation: pulse-ring 2s ease-in-out infinite;
    }
    
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
  <style>@view-transition { navigation: auto; }</style>
 </head>
 <body class="h-full gradient-bg text-white overflow-hidden">
  <div id="app" class="h-full flex flex-col"><!-- Header -->
   <header class="flex-shrink-0 px-4 py-3 glass-effect border-b border-white/10">
    <div class="flex items-center justify-between">
     <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-orange-500 flex items-center justify-center">
       <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" /> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z" />
       </svg>
      </div>
      <div>
       <h1 id="app-title" class="text-lg font-bold text-white">HeatSentry</h1>
       <p class="text-xs text-gray-400">ระบบเฝ้าระวังฮีทสโตรก</p>
      </div>
     </div>
     <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 px-2 py-1 rounded-lg bg-green-500/20 text-green-400 text-xs">
       <div class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></div><span>เชื่อมต่อแล้ว</span>
      </div><button id="settings-btn" class="w-9 h-9 rounded-xl glass-effect flex items-center justify-center hover:bg-white/20 transition-all">
       <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
       </svg></button>
     </div>
    </div>
   </header><!-- Main Content -->
   <main class="flex-1 overflow-y-auto scrollbar-hide"><!-- Page 1: Dashboard -->
    <div id="page-dashboard" class="page h-full p-4 space-y-4"><!-- Risk Level Banner -->
     <div id="risk-banner" class="rounded-2xl p-4 risk-green card-shadow">
      <div class="flex items-center justify-between">
       <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center">
         <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
         </svg>
        </div>
        <div>
         <p class="text-white/80 text-sm">สถานะความเสี่ยง</p>
         <p id="risk-text" class="text-xl font-bold text-white">ปลอดภัย</p>
        </div>
       </div>
       <div class="text-right">
        <p class="text-white/80 text-xs">Heat Index</p>
        <p id="heat-index" class="text-2xl font-bold orbitron">28°</p>
       </div>
      </div>
     </div><!-- Vitals Grid -->
     <div class="grid grid-cols-2 gap-3"><!-- Heart Rate -->
      <div class="rounded-2xl p-4 glass-effect card-shadow col-span-2">
       <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
         <div class="w-8 h-8 rounded-lg bg-red-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-red-400 animate-heartbeat" fill="currentColor" viewbox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
          </svg>
         </div><span class="text-gray-400 text-sm">Heart Rate</span>
        </div><span class="text-xs text-green-400 bg-green-400/20 px-2 py-1 rounded-full">Real-time</span>
       </div>
       <div class="flex items-end justify-between">
        <div><span id="heart-rate" class="text-5xl font-bold orbitron text-white">72</span> <span class="text-gray-400 text-lg ml-1">BPM</span>
        </div>
        <div class="flex gap-1 items-end h-12">
         <div class="w-2 bg-red-400/60 rounded-t" style="height: 40%"></div>
         <div class="w-2 bg-red-400/60 rounded-t" style="height: 70%"></div>
         <div class="w-2 bg-red-400/60 rounded-t" style="height: 50%"></div>
         <div class="w-2 bg-red-400/60 rounded-t" style="height: 90%"></div>
         <div class="w-2 bg-red-400/60 rounded-t" style="height: 60%"></div>
         <div class="w-2 bg-red-400/60 rounded-t" style="height: 80%"></div>
         <div class="w-2 bg-red-400 rounded-t" style="height: 75%"></div>
        </div>
       </div>
      </div><!-- Core Temp -->
      <div class="rounded-2xl p-4 glass-effect card-shadow">
       <div class="flex items-center gap-2 mb-2">
        <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg><span class="text-gray-400 text-xs">Core Temp</span>
       </div>
       <p id="core-temp" class="text-3xl font-bold orbitron text-white">37.2°</p>
       <p class="text-xs text-gray-500 mt-1">อุณหภูมิแกนกลาง</p>
      </div><!-- Ambient Temp -->
      <div class="rounded-2xl p-4 glass-effect card-shadow">
       <div class="flex items-center gap-2 mb-2">
        <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg><span class="text-gray-400 text-xs">อากาศ</span>
       </div>
       <p id="ambient-temp" class="text-3xl font-bold orbitron text-white">34°</p>
       <p class="text-xs text-gray-500 mt-1">อุณหภูมิภายนอก</p>
      </div>
     </div><!-- Mini Map -->
     <div class="rounded-2xl overflow-hidden card-shadow">
      <div class="map-container h-32">
       <div class="map-grid"></div>
       <div class="location-dot"></div>
       <div class="absolute bottom-2 left-2 glass-effect rounded-lg px-2 py-1 text-xs"><span class="text-gray-300">📍 กรุงเทพฯ</span>
       </div>
       <div class="absolute bottom-2 right-2 glass-effect rounded-lg px-2 py-1 text-xs"><span id="coordinates" class="text-gray-300 orbitron">13.7563°N, 100.5018°E</span>
       </div>
      </div>
     </div><!-- Quick Actions -->
     <div class="grid grid-cols-3 gap-3"><button id="btn-activity" class="rounded-xl p-3 glass-effect hover:bg-white/20 transition-all flex flex-col items-center gap-2">
       <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center">
        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
       </div><span class="text-xs text-gray-300">เริ่มวิ่ง</span> </button> <button id="btn-profile" class="rounded-xl p-3 glass-effect hover:bg-white/20 transition-all flex flex-col items-center gap-2">
       <div class="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center">
        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
       </div><span class="text-xs text-gray-300">Medical ID</span> </button> <button id="btn-test-sos" class="rounded-xl p-3 glass-effect hover:bg-white/20 transition-all flex flex-col items-center gap-2">
       <div class="w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center">
        <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
       </div><span class="text-xs text-gray-300">ทดสอบ SOS</span> </button>
     </div>
    </div><!-- Page 2: Activity Mode -->
    <div id="page-activity" class="page h-full p-4 hidden flex flex-col"><!-- Activity Header -->
     <div class="flex items-center justify-between mb-4"><button id="btn-back-activity" class="w-10 h-10 rounded-xl glass-effect flex items-center justify-center">
       <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
       </svg></button>
      <div class="text-center">
       <p class="text-gray-400 text-sm">โหมดวิ่ง</p>
       <p id="activity-timer" class="text-2xl font-bold orbitron">00:00:00</p>
      </div>
      <div id="activity-status" class="px-3 py-1 rounded-full bg-green-500/20 text-green-400 text-sm">
       กำลังวิ่ง
      </div>
     </div><!-- Large Heart Rate Display -->
     <div class="flex-1 flex flex-col items-center justify-center">
      <div class="relative">
       <div class="w-48 h-48 rounded-full glass-effect flex items-center justify-center animate-pulse-ring">
        <div class="text-center">
         <svg class="w-12 h-12 text-red-400 mx-auto mb-2 animate-heartbeat" fill="currentColor" viewbox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
         </svg>
         <p id="activity-hr" class="text-5xl font-bold orbitron text-white">72</p>
         <p class="text-gray-400">BPM</p>
        </div>
       </div>
      </div><!-- Risk Graph -->
      <div class="w-full mt-6 px-4">
       <p class="text-gray-400 text-sm mb-2">กราฟความเสี่ยง (30 นาทีล่าสุด)</p>
       <div class="h-20 rounded-xl glass-effect p-3 flex items-end gap-1">
        <div class="flex-1 bg-green-500/60 rounded-t" style="height: 30%"></div>
        <div class="flex-1 bg-green-500/60 rounded-t" style="height: 35%"></div>
        <div class="flex-1 bg-green-500/60 rounded-t" style="height: 40%"></div>
        <div class="flex-1 bg-yellow-500/60 rounded-t" style="height: 55%"></div>
        <div class="flex-1 bg-yellow-500/60 rounded-t" style="height: 50%"></div>
        <div class="flex-1 bg-green-500/60 rounded-t" style="height: 45%"></div>
        <div class="flex-1 bg-green-500/60 rounded-t" style="height: 40%"></div>
        <div class="flex-1 bg-green-500/60 rounded-t" style="height: 35%"></div>
        <div class="flex-1 bg-yellow-500/60 rounded-t" style="height: 60%"></div>
        <div class="flex-1 bg-green-500/60 rounded-t" style="height: 45%"></div>
        <div class="flex-1 bg-green-500/60 rounded-t" style="height: 38%"></div>
        <div class="flex-1 bg-green-500 rounded-t animate-pulse" style="height: 42%"></div>
       </div>
      </div><!-- Stats Row -->
      <div class="w-full grid grid-cols-3 gap-3 mt-4 px-4">
       <div class="rounded-xl glass-effect p-3 text-center">
        <p class="text-gray-400 text-xs">ระยะทาง</p>
        <p id="activity-distance" class="text-xl font-bold orbitron">2.4</p>
        <p class="text-gray-500 text-xs">กม.</p>
       </div>
       <div class="rounded-xl glass-effect p-3 text-center">
        <p class="text-gray-400 text-xs">แคลอรี่</p>
        <p id="activity-calories" class="text-xl font-bold orbitron">186</p>
        <p class="text-gray-500 text-xs">kcal</p>
       </div>
       <div class="rounded-xl glass-effect p-3 text-center">
        <p class="text-gray-400 text-xs">ความเร็ว</p>
        <p id="activity-pace" class="text-xl font-bold orbitron">5:30</p>
        <p class="text-gray-500 text-xs">นาที/กม.</p>
       </div>
      </div>
     </div><!-- Big SOS Button -->
     <div class="mt-4 px-4"><button id="big-sos-btn" class="w-full py-6 rounded-2xl sos-button text-white text-2xl font-bold flex items-center justify-center gap-3 active:scale-95 transition-transform">
       <svg class="w-8 h-8" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
       </svg> 🆘 SOS ฉุกเฉิน </button>
      <p class="text-center text-gray-500 text-xs mt-2">กดค้าง 3 วินาทีเพื่อส่งสัญญาณขอความช่วยเหลือ</p>
     </div>
    </div><!-- Page 3: Medical Profile -->
    <div id="page-profile" class="page h-full p-4 hidden overflow-y-auto"><!-- Profile Header -->
     <div class="flex items-center justify-between mb-4"><button id="btn-back-profile" class="w-10 h-10 rounded-xl glass-effect flex items-center justify-center">
       <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
       </svg></button>
      <h2 class="text-lg font-bold">Medical ID</h2>
      <div class="w-10"></div>
     </div><!-- Profile Form -->
     <div id="profile-form" class="space-y-4">
      <div class="rounded-2xl glass-effect p-4 card-shadow">
       <h3 class="text-sm text-gray-400 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg> ข้อมูลส่วนตัว</h3>
       <div class="space-y-3">
        <div><label for="profile-name" class="text-xs text-gray-500 block mb-1">ชื่อ-นามสกุล</label> <input type="text" id="profile-name" placeholder="กรอกชื่อของคุณ" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500">
        </div>
        <div><label for="profile-blood" class="text-xs text-gray-500 block mb-1">กรุ๊ปเลือด</label> <select id="profile-blood" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white"> <option value="">เลือกกรุ๊ปเลือด</option> <option value="A+">A+</option> <option value="A-">A-</option> <option value="B+">B+</option> <option value="B-">B-</option> <option value="AB+">AB+</option> <option value="AB-">AB-</option> <option value="O+">O+</option> <option value="O-">O-</option> </select>
        </div>
       </div>
      </div>
      <div class="rounded-2xl glass-effect p-4 card-shadow">
       <h3 class="text-sm text-gray-400 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg> ข้อมูลทางการแพทย์</h3>
       <div class="space-y-3">
        <div><label for="profile-conditions" class="text-xs text-gray-500 block mb-1">โรคประจำตัว</label> <textarea id="profile-conditions" rows="2" placeholder="เช่น โรคหัวใจ, ความดันโลหิตสูง" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 resize-none"></textarea>
        </div>
        <div><label for="profile-allergies" class="text-xs text-gray-500 block mb-1">ประวัติแพ้ยา</label> <textarea id="profile-allergies" rows="2" placeholder="เช่น แพ้เพนนิซิลิน, แพ้แอสไพริน" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500 resize-none"></textarea>
        </div>
       </div>
      </div>
      <div class="rounded-2xl glass-effect p-4 card-shadow">
       <h3 class="text-sm text-gray-400 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg> ผู้ติดต่อฉุกเฉิน</h3>
       <div class="space-y-3">
        <div><label for="profile-emergency-name" class="text-xs text-gray-500 block mb-1">ชื่อผู้ติดต่อ</label> <input type="text" id="profile-emergency-name" placeholder="ชื่อคนที่ต้องการแจ้งเมื่อเกิดเหตุ" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500">
        </div>
        <div><label for="profile-emergency-phone" class="text-xs text-gray-500 block mb-1">เบอร์โทรศัพท์</label> <input type="tel" id="profile-emergency-phone" placeholder="0XX-XXX-XXXX" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-gray-500">
        </div>
       </div>
      </div><button id="save-profile-btn" class="w-full py-4 rounded-2xl bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold flex items-center justify-center gap-2 hover:from-blue-600 hover:to-blue-700 transition-all">
       <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
       </svg> บันทึกข้อมูล </button>
      <p id="save-status" class="text-center text-sm text-gray-500 hidden"></p>
     </div>
    </div><!-- Page 4: Rescue Card -->
    <div id="page-rescue" class="page h-full p-4 hidden flex flex-col">
     <div class="flex-1 flex flex-col"><!-- Emergency Header -->
      <div class="text-center mb-4">
       <div class="w-20 h-20 mx-auto rounded-full bg-red-500/20 flex items-center justify-center mb-3 animate-danger-pulse">
        <svg class="w-10 h-10 text-red-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
       </div>
       <h2 class="text-2xl font-bold text-red-400">⚠️ EMERGENCY</h2>
       <p class="text-gray-400">ข้อมูลสำหรับผู้พบเห็น</p>
      </div><!-- Medical Tag -->
      <div class="rounded-2xl bg-gradient-to-br from-red-900/50 to-red-800/30 border border-red-500/30 p-4 card-shadow mb-4">
       <div class="flex items-center gap-3 mb-4 pb-3 border-b border-red-500/20">
        <div class="w-16 h-16 rounded-xl bg-white flex items-center justify-center"><span id="rescue-blood" class="text-3xl font-bold text-red-500">A+</span>
        </div>
        <div>
         <p id="rescue-name" class="text-xl font-bold text-white">ไม่ระบุชื่อ</p>
         <p class="text-red-300 text-sm">กรุ๊ปเลือด</p>
        </div>
       </div>
       <div class="space-y-3">
        <div>
         <p class="text-red-300 text-xs mb-1">🏥 โรคประจำตัว</p>
         <p id="rescue-conditions" class="text-white">ไม่มีข้อมูล</p>
        </div>
        <div>
         <p class="text-red-300 text-xs mb-1">💊 แพ้ยา</p>
         <p id="rescue-allergies" class="text-white">ไม่มีข้อมูล</p>
        </div>
       </div>
      </div><!-- Emergency Contact --> <a id="rescue-call-btn" href="tel:1669" class="block w-full py-4 rounded-2xl bg-gradient-to-r from-green-500 to-green-600 text-white font-bold text-center mb-3 hover:from-green-600 hover:to-green-700 transition-all"> <span class="flex items-center justify-center gap-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg> 📞 โทร 1669 (สายด่วนฉุกเฉิน) </span> </a> <button id="rescue-contact-btn" class="w-full py-4 rounded-2xl glass-effect border border-white/20 text-white font-bold flex items-center justify-center gap-2 mb-4">
       <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
       </svg><span id="rescue-contact-text">โทรหาผู้ติดต่อฉุกเฉิน</span> </button> <!-- First Aid Guide -->
      <div class="rounded-2xl glass-effect p-4 card-shadow">
       <h3 class="text-sm font-bold text-yellow-400 mb-3 flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg> วิธีปฐมพยาบาลฮีทสโตรก</h3>
       <ol class="text-sm text-gray-300 space-y-2">
        <li class="flex gap-2"><span class="text-yellow-400 font-bold">1.</span> <span>ย้ายผู้ป่วยไปที่ร่ม ให้นอนราบ ยกขาสูง</span></li>
        <li class="flex gap-2"><span class="text-yellow-400 font-bold">2.</span> <span>ถอดเสื้อผ้าออก ใช้น้ำเย็นราดตัว</span></li>
        <li class="flex gap-2"><span class="text-yellow-400 font-bold">3.</span> <span>ประคบน้ำแข็งที่ขาหนีบ, รักแร้, คอ</span></li>
        <li class="flex gap-2"><span class="text-yellow-400 font-bold">4.</span> <span>พัดลมหรือใช้มือพัดให้ลมโกรก</span></li>
        <li class="flex gap-2"><span class="text-yellow-400 font-bold">5.</span> <span>รอหน่วยกู้ชีพ อย่าให้ผู้ป่วยดื่มน้ำถ้าหมดสติ</span></li>
       </ol>
      </div>
     </div><button id="btn-back-rescue" class="mt-4 py-3 rounded-xl glass-effect text-gray-400 hover:text-white transition-all"> ← กลับหน้าหลัก </button>
    </div>
   </main><!-- Bottom Navigation -->
   <nav class="flex-shrink-0 px-4 py-3 glass-effect border-t border-white/10">
    <div class="flex justify-around"><button data-page="dashboard" class="nav-item w-14 h-14 rounded-2xl flex flex-col items-center justify-center gap-1 active">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg><span class="text-xs">หน้าหลัก</span> </button> <button data-page="activity" class="nav-item w-14 h-14 rounded-2xl flex flex-col items-center justify-center gap-1">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg><span class="text-xs">วิ่ง</span> </button> <button data-page="profile" class="nav-item w-14 h-14 rounded-2xl flex flex-col items-center justify-center gap-1">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg><span class="text-xs">โปรไฟล์</span> </button> <button data-page="rescue" class="nav-item w-14 h-14 rounded-2xl flex flex-col items-center justify-center gap-1">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg><span class="text-xs">กู้ชีพ</span> </button>
    </div>
   </nav><!-- Emergency Alert Overlay -->
   <div id="emergency-overlay" class="fixed inset-0 bg-black/95 z-50 hidden flex flex-col items-center justify-center p-6">
    <div class="text-center">
     <div class="w-32 h-32 mx-auto rounded-full animate-siren flex items-center justify-center mb-6">
      <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
     </div>
     <h2 class="text-3xl font-bold text-white mb-2">🚨 ตรวจพบเหตุฉุกเฉิน!</h2>
     <p class="text-red-300 mb-6">ระบบจะส่งสัญญาณ SOS อัตโนมัติใน</p>
     <div id="countdown-display" class="text-8xl font-bold orbitron text-white mb-8 animate-countdown">
      30
     </div><button id="im-okay-btn" class="w-full py-6 rounded-2xl bg-gradient-to-r from-green-500 to-green-600 text-white text-2xl font-bold mb-4 hover:from-green-600 hover:to-green-700 transition-all"> ✅ ฉันปลอดภัย </button> <button id="siren-btn" class="w-full py-4 rounded-2xl glass-effect border border-red-500/50 text-red-400 font-bold flex items-center justify-center gap-2">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
      </svg> 🔊 เปิดเสียงไซเรน </button>
     <p class="text-gray-500 text-sm mt-4">กดปุ่มด้านบนถ้าคุณปลอดภัย</p>
    </div>
   </div><!-- SOS Sent Confirmation -->
   <div id="sos-sent-overlay" class="fixed inset-0 bg-black/95 z-50 hidden flex flex-col items-center justify-center p-6">
    <div class="text-center">
     <div class="w-24 h-24 mx-auto rounded-full bg-green-500/20 flex items-center justify-center mb-6">
      <svg class="w-12 h-12 text-green-400" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
     </div>
     <h2 class="text-2xl font-bold text-white mb-2">📤 ส่งสัญญาณ SOS แล้ว</h2>
     <p class="text-gray-400 mb-6">ข้อความฉุกเฉินถูกส่งไปยังผู้ติดต่อของคุณแล้ว</p>
     <div class="rounded-2xl glass-effect p-4 mb-6 text-left">
      <p class="text-gray-400 text-sm mb-2">ข้อความที่ส่ง:</p>
      <p id="sos-message-preview" class="text-white text-sm"></p>
     </div><button id="view-rescue-btn" class="w-full py-4 rounded-2xl bg-gradient-to-r from-red-500 to-red-600 text-white font-bold mb-3"> ดูหน้ากู้ชีพ (Rescue Card) </button> <button id="close-sos-overlay" class="w-full py-3 rounded-xl glass-effect text-gray-400"> ปิด </button>
    </div>
   </div><!-- Toast Notification -->
   <div id="toast" class="fixed top-20 left-1/2 transform -translate-x-1/2 px-6 py-3 rounded-xl glass-effect text-white text-sm z-40 hidden animate-slide-up"><span id="toast-message"></span>
   </div>
  </div>
  <script>
    // Default Configuration
    const defaultConfig = {
      app_title: 'HeatSentry',
      emergency_message: '緊急! พบผู้ป่วยสงสัยภาวะ Heatstroke',
      primary_color: '#3b82f6',
      secondary_color: '#1e293b',
      accent_color: '#ef4444',
      text_color: '#ffffff',
      background_color: '#0f172a'
    };
    
    let config = { ...defaultConfig };
    let profileData = null;
    let activityInterval = null;
    let activitySeconds = 0;
    let countdownInterval = null;
    let sirenAudio = null;
    
    // Data SDK Handler
    const dataHandler = {
      onDataChanged(data) {
        if (data && data.length > 0) {
          profileData = data[0];
          updateProfileForm(profileData);
          updateRescueCard(profileData);
        }
      }
    };
    
    // Initialize SDKs
    async function initApp() {
      // Initialize Element SDK
      if (window.elementSdk) {
        window.elementSdk.init({
          defaultConfig,
          onConfigChange: async (newConfig) => {
            config = { ...defaultConfig, ...newConfig };
            applyConfig();
          },
          mapToCapabilities: (cfg) => ({
            recolorables: [
              {
                get: () => cfg.primary_color || defaultConfig.primary_color,
                set: (value) => {
                  cfg.primary_color = value;
                  window.elementSdk.setConfig({ primary_color: value });
                }
              },
              {
                get: () => cfg.accent_color || defaultConfig.accent_color,
                set: (value) => {
                  cfg.accent_color = value;
                  window.elementSdk.setConfig({ accent_color: value });
                }
              },
              {
                get: () => cfg.background_color || defaultConfig.background_color,
                set: (value) => {
                  cfg.background_color = value;
                  window.elementSdk.setConfig({ background_color: value });
                }
              }
            ],
            borderables: [],
            fontEditable: undefined,
            fontSizeable: undefined
          }),
          mapToEditPanelValues: (cfg) => new Map([
            ['app_title', cfg.app_title || defaultConfig.app_title],
            ['emergency_message', cfg.emergency_message || defaultConfig.emergency_message]
          ])
        });
        
        if (window.elementSdk.config) {
          config = { ...defaultConfig, ...window.elementSdk.config };
        }
      }
      
      // Initialize Data SDK
      if (window.dataSdk) {
        const result = await window.dataSdk.init(dataHandler);
        if (!result.isOk) {
          console.error('Failed to initialize Data SDK');
        }
      }
      
      applyConfig();
      initNavigation();
      initEventListeners();
      startVitalsSimulation();
    }
    
    // Apply Configuration
    function applyConfig() {
      document.getElementById('app-title').textContent = config.app_title || defaultConfig.app_title;
    }
    
    // Update Profile Form
    function updateProfileForm(data) {
      if (!data) return;
      
      document.getElementById('profile-name').value = data.name || '';
      document.getElementById('profile-blood').value = data.blood_type || '';
      document.getElementById('profile-conditions').value = data.medical_conditions || '';
      document.getElementById('profile-allergies').value = data.allergies || '';
      document.getElementById('profile-emergency-name').value = data.emergency_contact_name || '';
      document.getElementById('profile-emergency-phone').value = data.emergency_contact_phone || '';
    }
    
    // Update Rescue Card
    function updateRescueCard(data) {
      if (!data) return;
      
      document.getElementById('rescue-name').textContent = data.name || 'ไม่ระบุชื่อ';
      document.getElementById('rescue-blood').textContent = data.blood_type || '?';
      document.getElementById('rescue-conditions').textContent = data.medical_conditions || 'ไม่มีข้อมูล';
      document.getElementById('rescue-allergies').textContent = data.allergies || 'ไม่มีข้อมูล';
      
      if (data.emergency_contact_phone) {
        document.getElementById('rescue-contact-btn').onclick = () => {
          window.open(`tel:${data.emergency_contact_phone}`, '_blank');
        };
        document.getElementById('rescue-contact-text').textContent = `โทรหา ${data.emergency_contact_name || 'ผู้ติดต่อฉุกเฉิน'}`;
      }
    }
    
    // Navigation
    function initNavigation() {
      const navButtons = document.querySelectorAll('[data-page]');
      const pages = document.querySelectorAll('.page');
      
      navButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const targetPage = btn.dataset.page;
          
          navButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          
          pages.forEach(page => {
            page.classList.add('hidden');
            if (page.id === `page-${targetPage}`) {
              page.classList.remove('hidden');
            }
          });
        });
      });
    }
    
    // Show Page
    function showPage(pageName) {
      const navButtons = document.querySelectorAll('[data-page]');
      const pages = document.querySelectorAll('.page');
      
      navButtons.forEach(b => {
        b.classList.remove('active');
        if (b.dataset.page === pageName) {
          b.classList.add('active');
        }
      });
      
      pages.forEach(page => {
        page.classList.add('hidden');
        if (page.id === `page-${pageName}`) {
          page.classList.remove('hidden');
        }
      });
    }
    
    // Event Listeners
    function initEventListeners() {
      // Quick Actions
      document.getElementById('btn-activity').addEventListener('click', () => {
        showPage('activity');
        startActivity();
      });
      
      document.getElementById('btn-profile').addEventListener('click', () => {
        showPage('profile');
      });
      
      document.getElementById('btn-test-sos').addEventListener('click', () => {
        triggerEmergency();
      });
      
      // Back Buttons
      document.getElementById('btn-back-activity').addEventListener('click', () => {
        stopActivity();
        showPage('dashboard');
      });
      
      document.getElementById('btn-back-profile').addEventListener('click', () => {
        showPage('dashboard');
      });
      
      document.getElementById('btn-back-rescue').addEventListener('click', () => {
        showPage('dashboard');
      });
      
      // Save Profile
      document.getElementById('save-profile-btn').addEventListener('click', saveProfile);
      
      // Emergency Controls
      document.getElementById('im-okay-btn').addEventListener('click', cancelEmergency);
      document.getElementById('siren-btn').addEventListener('click', toggleSiren);
      document.getElementById('big-sos-btn').addEventListener('click', triggerEmergency);
      
      // SOS Sent Overlay
      document.getElementById('view-rescue-btn').addEventListener('click', () => {
        document.getElementById('sos-sent-overlay').classList.add('hidden');
        showPage('rescue');
      });
      
      document.getElementById('close-sos-overlay').addEventListener('click', () => {
        document.getElementById('sos-sent-overlay').classList.add('hidden');
      });
    }
    
    // Save Profile
    async function saveProfile() {
      const btn = document.getElementById('save-profile-btn');
      const status = document.getElementById('save-status');
      
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> กำลังบันทึก...';
      
      const newData = {
        id: profileData ? profileData.id : Date.now().toString(),
        name: document.getElementById('profile-name').value,
        blood_type: document.getElementById('profile-blood').value,
        medical_conditions: document.getElementById('profile-conditions').value,
        allergies: document.getElementById('profile-allergies').value,
        emergency_contact_name: document.getElementById('profile-emergency-name').value,
        emergency_contact_phone: document.getElementById('profile-emergency-phone').value,
        created_at: new Date().toISOString()
      };
      
      if (window.dataSdk) {
        let result;
        if (profileData && profileData.__backendId) {
          result = await window.dataSdk.update({ ...newData, __backendId: profileData.__backendId });
        } else {
          result = await window.dataSdk.create(newData);
        }
        
        if (result.isOk) {
          showToast('✅ บันทึกข้อมูลสำเร็จ');
          status.textContent = 'บันทึกเรียบร้อยแล้ว';
          status.classList.remove('hidden', 'text-red-400');
          status.classList.add('text-green-400');
        } else {
          showToast('❌ เกิดข้อผิดพลาด');
          status.textContent = 'เกิดข้อผิดพลาดในการบันทึก';
          status.classList.remove('hidden', 'text-green-400');
          status.classList.add('text-red-400');
        }
      }
      
      btn.disabled = false;
      btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> บันทึกข้อมูล';
      
      setTimeout(() => {
        status.classList.add('hidden');
      }, 3000);
    }
    
    // Activity Mode
    function startActivity() {
      activitySeconds = 0;
      updateActivityTimer();
      activityInterval = setInterval(() => {
        activitySeconds++;
        updateActivityTimer();
      }, 1000);
    }
    
    function stopActivity() {
      if (activityInterval) {
        clearInterval(activityInterval);
        activityInterval = null;
      }
    }
    
    function updateActivityTimer() {
      const hours = Math.floor(activitySeconds / 3600);
      const minutes = Math.floor((activitySeconds % 3600) / 60);
      const seconds = activitySeconds % 60;
      
      const timerStr = [hours, minutes, seconds]
        .map(n => n.toString().padStart(2, '0'))
        .join(':');
      
      document.getElementById('activity-timer').textContent = timerStr;
    }
    
    // Emergency Functions
    function triggerEmergency() {
      document.getElementById('emergency-overlay').classList.remove('hidden');
      startCountdown();
    }
    
    function cancelEmergency() {
      document.getElementById('emergency-overlay').classList.add('hidden');
      stopCountdown();
      stopSiren();
      showToast('✅ ยกเลิกสัญญาณฉุกเฉินแล้ว');
    }
    
    function startCountdown() {
      let countdown = 30;
      document.getElementById('countdown-display').textContent = countdown;
      
      countdownInterval = setInterval(() => {
        countdown--;
        document.getElementById('countdown-display').textContent = countdown;
        
        if (countdown <= 0) {
          stopCountdown();
          sendSOS();
        }
      }, 1000);
    }
    
    function stopCountdown() {
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
    }
    
    function sendSOS() {
      document.getElementById('emergency-overlay').classList.add('hidden');
      
      const lat = 13.7563 + (Math.random() * 0.01 - 0.005);
      const lng = 100.5018 + (Math.random() * 0.01 - 0.005);
      const mapsLink = `https://maps.google.com/?q=${lat.toFixed(6)},${lng.toFixed(6)}`;
      
      const emergencyMsg = config.emergency_message || defaultConfig.emergency_message;
      const name = profileData?.name || 'ไม่ระบุชื่อ';
      const bloodType = profileData?.blood_type || 'ไม่ทราบ';
      const conditions = profileData?.medical_conditions || 'ไม่มี';
      
      const fullMessage = `${emergencyMsg}\n\n👤 ชื่อ: ${name}\n🩸 กรุ๊ปเลือด: ${bloodType}\n🏥 โรคประจำตัว: ${conditions}\n\n📍 ตำแหน่ง: ${mapsLink}`;
      
      document.getElementById('sos-message-preview').textContent = fullMessage;
      document.getElementById('sos-sent-overlay').classList.remove('hidden');
      
      showToast('📤 ส่งสัญญาณ SOS แล้ว');
    }
    
    // Siren
    function toggleSiren() {
      const btn = document.getElementById('siren-btn');
      
      if (!sirenAudio) {
        // Create oscillator for siren sound
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        
        oscillator.type = 'sawtooth';
        gainNode.gain.value = 0.3;
        
        let freq = 440;
        let increasing = true;
        
        setInterval(() => {
          if (increasing) {
            freq += 20;
            if (freq >= 880) increasing = false;
          } else {
            freq -= 20;
            if (freq <= 440) increasing = true;
          }
          oscillator.frequency.value = freq;
        }, 50);
        
        oscillator.start();
        sirenAudio = { context: audioContext, oscillator, gainNode };
        
        btn.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" clip-rule="evenodd"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg> 🔇 ปิดเสียงไซเรน';
        btn.classList.add('bg-red-500/20');
      } else {
        stopSiren();
      }
    }
    
    function stopSiren() {
      if (sirenAudio) {
        sirenAudio.oscillator.stop();
        sirenAudio.context.close();
        sirenAudio = null;
        
        const btn = document.getElementById('siren-btn');
        btn.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg> 🔊 เปิดเสียงไซเรน';
        btn.classList.remove('bg-red-500/20');
      }
    }
    
    // Vitals Simulation
    function startVitalsSimulation() {
      setInterval(() => {
        // Simulate heart rate (60-100 at rest)
        const baseHR = 72;
        const variation = Math.floor(Math.random() * 10) - 5;
        const hr = baseHR + variation;
        
        document.getElementById('heart-rate').textContent = hr;
        document.getElementById('activity-hr').textContent = hr;
        
        // Update risk level based on HR
        updateRiskLevel(hr);
        
        // Simulate temperature changes
        const coreTemp = (37.0 + Math.random() * 0.4).toFixed(1);
        document.getElementById('core-temp').textContent = coreTemp + '°';
        
        const ambientTemp = Math.floor(32 + Math.random() * 4);
        document.getElementById('ambient-temp').textContent = ambientTemp + '°';
        
        const heatIndex = ambientTemp + Math.floor(Math.random() * 3);
        document.getElementById('heat-index').textContent = heatIndex + '°';
        
      }, 2000);
    }
    
    function updateRiskLevel(hr) {
      const banner = document.getElementById('risk-banner');
      const riskText = document.getElementById('risk-text');
      const icon = banner.querySelector('svg');
      
      banner.classList.remove('risk-green', 'risk-yellow', 'risk-red');
      
      if (hr < 100) {
        banner.classList.add('risk-green');
        riskText.textContent = 'ปลอดภัย';
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>';
      } else if (hr < 140) {
        banner.classList.add('risk-yellow');
        riskText.textContent = 'เริ่มเสี่ยง';
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>';
      } else {
        banner.classList.add('risk-red');
        riskText.textContent = 'อันตราย!';
        banner.classList.add('animate-danger-pulse');
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>';
      }
    }
    
    // Toast Notification
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-message').textContent = message;
      toast.classList.remove('hidden');
      
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3000);
    }
    
    // Initialize App
    initApp();
  </script>
 <script>(function(){function c(){var b=a.contentDocument||a.contentWindow.document;if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'9cc255df747c7334',t:'MTc3MDc5NzA2Ni4wMDAwMDA='};var a=document.createElement('script');a.nonce='';a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>
